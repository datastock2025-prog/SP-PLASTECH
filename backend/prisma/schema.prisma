// ==============================================================================
// SP-PLASTECH ERP — PRISMA MULTI-TENANT ENTERPRISE SCHEMA
// Strict Multi-Tenancy (tenantId), Decimal Precision, Audit & Versioning
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. TENANCY, AUTHENTICATION, RBAC & SESSIONS
// ------------------------------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "SP-HOSUR-01", "SP-CHENNAI-02"
  name        String   // "SP Plastech Hosur Plant"
  domain      String?
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               User[]
  roles               Role[]
  auditLogs           AuditLog[]
  items               Item[]
  suppliers           Supplier[]
  customers           Customer[]
  machines            Machine[]
  workOrders          WorkOrder[]
  molds               Mold[]
  dmsDocuments        DmsDocument[]
  apiKeys             ApiKey[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]

  @@index([code])
}

model User {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  fullName       String
  phone          String?
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  status         String    @default("ACTIVE") // ACTIVE, SUSPENDED, INACTIVE
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  backupCodes    Json      @default("[]")
  version        Int       @default(1)
  createdById    String?
  updatedById    String?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs      AuditLog[]
  sessions       UserSession[]

  @@index([tenantId, email])
}

model UserSession {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String
  ipAddress   String
  userAgent   String
  lastActiveAt DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([tenantId, userId, deviceId])
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  hashedKey   String    @unique
  scopes      Json      @default("[]")
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, prefix])
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String           // "ADMIN", "PLANT_MANAGER", "OPERATOR", "FINANCE"
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model RolePermission {
  id          String   @id @default(uuid())
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module      String   // "OPERATIONS", "FINANCE", "PROCUREMENT", "AI_CHAT", "QUALITY"
  action      String   // "READ", "CREATE", "UPDATE", "DELETE", "APPROVE"
  createdAt   DateTime @default(now())

  @@unique([roleId, module, action])
}

// ------------------------------------------------------------------------------
// 2. AUDIT LOGGING & IMMUTABLE VERSION SNAPSHOTS
// ------------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityName  String   // "Item", "Supplier", "PurchaseOrder", "WorkOrder", "Mold"
  recordId    String
  action      String   // "CREATE", "UPDATE", "DELETE", "AI_QUERY"
  oldData     Json?
  newData     Json?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([tenantId, entityName, recordId])
  @@index([tenantId, timestamp])
}

model EntityVersion {
  id          String   @id @default(uuid())
  tenantId    String
  entityName  String
  recordId    String
  version     Int
  snapshot    Json
  createdById String
  createdAt   DateTime @default(now())

  @@unique([tenantId, entityName, recordId, version])
  @@index([tenantId, entityName, recordId])
}

// ------------------------------------------------------------------------------
// ------------------------------------------------------------------------------
// 3. MASTER DATA: ITEMS, BOM, MACHINES & MOLDS
// ------------------------------------------------------------------------------

enum ItemCategory {
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED_GOOD
  MASTERBATCH
  SPARE_PART
  PACKAGING_MATERIAL
  REGRIND
}

enum ItemEntityType {
  FINISHED_MOLDED_COMPONENT
  RESIN_RAW_MATERIAL
  MASTERBATCH_COLORANT
  ASSEMBLY_SUB_COMPONENT
  PACKAGING_SUPPLY
  MACHINE_SPARE_PART
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PHASE_OUT
}

enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
  STANDARD_COST
}

/// Core Item Master record representing Raw Materials, Molded Finished Goods,
/// Masterbatches, Packaging, and Spares in the plastic manufacturing lifecycle.
model Item {
  id                String          @id @default(uuid()) @map("id")
  tenantId          String          @map("tenant_id")
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  code              String          @map("code") // "RM-PP-001", "FG-BKT-10L"
  name              String          @map("name")
  category          String          @default("Finished Good") @map("category") // "RAW_MATERIAL", "FINISHED_GOOD", etc.
  entityType        String          @default("Finished Molded Component") @map("entity_type")
  unit              String          @default("PCS") @map("unit") // "KG", "PCS", "BOX"
  stock             Decimal         @default(0) @db.Decimal(14, 4) @map("stock")
  minStock          Decimal         @default(0) @db.Decimal(14, 4) @map("min_stock")
  maxStock          Decimal         @default(5000) @db.Decimal(14, 4) @map("max_stock")
  reorderPoint      Decimal         @default(0) @db.Decimal(14, 4) @map("reorder_point")
  safetyStock       Decimal         @default(0) @db.Decimal(14, 4) @map("safety_stock")
  cost              Decimal         @default(0) @db.Decimal(14, 4) @map("cost")
  sellingPrice      Decimal         @default(0) @db.Decimal(14, 4) @map("selling_price")
  valuationMethod   String          @default("FIFO") @map("valuation_method")
  partWeightGrams   Decimal         @default(0) @db.Decimal(10, 3) @map("part_weight_grams")
  runnerWeightGrams Decimal         @default(0) @db.Decimal(10, 3) @map("runner_weight_grams")
  cavityCount       Int             @default(1) @map("cavity_count")
  cycleTimeSeconds  Decimal         @default(0) @db.Decimal(8, 2) @map("cycle_time_seconds")
  moldCode          String?         @map("mold_code")
  resinType         String?         @map("resin_type")
  polymerGrade      String?         @map("polymer_grade")
  color             String?         @map("color")
  hsnCode           String?         @map("hsn_code")
  itemGroup         String?         @map("item_group")
  description       String?         @map("description")
  status            String          @default("ACTIVE") @map("status")
  approvalStatus    String          @default("APPROVED") @map("approval_status")
  approvedBy        String?         @map("approved_by")
  version           Int             @default(1) @map("version")
  createdById       String?         @map("created_by_id")
  updatedById       String?         @map("updated_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")

  boms              BillOfMaterial[]
  bomComponents     BomComponent[]

  @@unique([tenantId, code])
  @@index([tenantId, category, status])
  @@index([tenantId, createdAt])
  @@map("items")
}

/// Manufacturing Bill of Materials (BOM) linking parent item to child components
model BillOfMaterial {
  id           String         @id @default(uuid()) @map("id")
  tenantId     String         @map("tenant_id")
  bomNumber    String         @map("bom_number")
  parentItemId String         @map("parent_item_id")
  parentItem   Item           @relation(fields: [parentItemId], references: [id], onDelete: Restrict)
  version      Int            @default(1) @map("version")
  isActive     Boolean        @default(true) @map("is_active")
  yieldPercent Decimal        @default(100.0) @db.Decimal(5, 2) @map("yield_percent")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  components   BomComponent[]

  @@unique([tenantId, bomNumber])
  @@index([tenantId, parentItemId])
  @@map("bill_of_materials")
}

/// Explicit junction model for BOM Line components
model BomComponent {
  id              String         @id @default(uuid()) @map("id")
  bomId           String         @map("bom_id")
  bom             BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentItemId String         @map("component_item_id")
  componentItem   Item           @relation(fields: [componentItemId], references: [id], onDelete: Restrict)
  quantity        Decimal        @db.Decimal(14, 6) @map("quantity")
  uom             String         @default("KG") @map("uom")
  scrapPercentage Decimal        @default(0) @db.Decimal(5, 2) @map("scrap_percentage")
  remarks         String?        @map("remarks")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([bomId])
  @@index([componentItemId])
  @@map("bom_items")
}

model Machine {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  machineCode   String
  name          String
  machineType   String
  tonnage       Int
  plantLocation String      @default("Shopfloor Bay 1")
  status        String      @default("RUNNING") // RUNNING, IDLE, BREAKDOWN, MAINTENANCE
  oeePercentage Decimal     @default(85.0) @db.Decimal(5, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workOrders    WorkOrder[]
  molds         Mold[]

  @@unique([tenantId, machineCode])
  @@index([tenantId, status])
}

model Mold {
  id                         String        @id @default(uuid())
  tenantId                   String
  tenant                     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moldCode                   String
  name                       String
  cavityCount                Int           @default(1)
  totalShots                 Int           @default(0)
  maxShotsBeforeMaintenance  Int           @default(50000)
  lastMaintenanceShots       Int           @default(0)
  status                     String        @default("ACTIVE") // ACTIVE, MAINTENANCE_REQUIRED, UNDER_MAINTENANCE, RETIRED
  mountedMachineId           String?
  mountedMachine             Machine?      @relation(fields: [mountedMachineId], references: [id])
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  shotLogs                   MoldShotLog[]

  @@unique([tenantId, moldCode])
  @@index([tenantId, status])
}

model MoldShotLog {
  id          String   @id @default(uuid())
  moldId      String
  mold        Mold     @relation(fields: [moldId], references: [id], onDelete: Cascade)
  shotsAdded  Int
  workOrderId String?
  operatorId  String?
  timestamp   DateTime @default(now())

  @@index([moldId])
}

model WorkOrder {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  woNumber         String
  itemCode         String
  itemName         String
  targetQuantity   Decimal  @db.Decimal(12, 2)
  producedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  rejectedQuantity Decimal  @default(0) @db.Decimal(12, 2)
  machineId        String?
  machine          Machine? @relation(fields: [machineId], references: [id])
  status           String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, woNumber])
  @@index([tenantId, status])
}

// ------------------------------------------------------------------------------
// 4. QUALITY (SPC) & SUSTAINABILITY (EPR & ENERGY)
// ------------------------------------------------------------------------------

model SpcInspection {
  id          String   @id @default(uuid())
  tenantId    String
  itemCode    String
  parameter   String   // e.g. "Wall Thickness (mm)", "Weight (g)"
  subgroupId  String
  samples     Json     // Array of numeric readings [1.24, 1.25, 1.23, 1.26, 1.24]
  subgroupMean Decimal @db.Decimal(10, 4)
  subgroupRange Decimal @db.Decimal(10, 4)
  isViolation Boolean  @default(false)
  violationRule String?
  inspectorId String
  createdAt   DateTime @default(now())

  @@index([tenantId, itemCode, parameter])
}

model EprCreditLog {
  id                      String   @id @default(uuid())
  tenantId                String
  period                  String   // "2026-Q1"
  category                String   // "CAT_I_RIGID", "CAT_II_FLEXIBLE"
  totalPlasticProducedKg  Decimal  @db.Decimal(14, 3)
  recycledPlasticUsedKg   Decimal  @db.Decimal(14, 3)
  mandatoryTargetPct      Decimal  @db.Decimal(5, 2)
  liabilityAmountInr      Decimal  @db.Decimal(14, 2)
  createdAt               DateTime @default(now())

  @@index([tenantId, period])
}

model EnergyLog {
  id               String   @id @default(uuid())
  tenantId         String
  machineId        String
  shiftDate        String
  shiftNumber      Int
  kwhConsumed      Decimal  @db.Decimal(10, 2)
  producedWeightKg Decimal  @db.Decimal(10, 2)
  kwhPerKg         Decimal  @db.Decimal(8, 4)
  costInr          Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  @@index([tenantId, machineId, shiftDate])
}

// ------------------------------------------------------------------------------
// 5. WORKFLOW ENGINE & DOCUMENT MANAGEMENT (DMS)
// ------------------------------------------------------------------------------

model WorkflowDefinition {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType  String   // "PURCHASE_ORDER", "SALES_ORDER", "WORK_ORDER"
  configJson  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances   WorkflowInstance[]

  @@unique([tenantId, entityType])
}

model WorkflowInstance {
  id                   String             @id @default(uuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowDefinitionId String
  workflowDefinition   WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  entityId             String
  currentState         String
  history              Json               @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([tenantId, entityId])
}

model DmsDocument {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folderPath   String
  fileName     String
  version      Int      @default(1)
  storageKey   String
  mimeType     String
  fileSizeBytes Int
  tags         Json     @default("[]")
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, folderPath])
}

// ------------------------------------------------------------------------------
// 6. PROCUREMENT & SALES
// ------------------------------------------------------------------------------

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  shortName     String?
  category      String
  status        String   @default("active")
  rating        Decimal  @default(4.5) @db.Decimal(3, 1)
  paymentTerms  String   @default("Net 60 Days")
  deliveryTerms String   @default("Ex Work")
  gstin         String?
  contacts      Json     @default("[]")
  addresses     Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  name         String
  customerType String   @default("OEM")
  tier         String   @default("Tier 1")
  gstin        String?
  creditLimit  Decimal  @default(1000000) @db.Decimal(14, 2)
  creditDays   Int      @default(45)
  status       String   @default("active")
  contacts     Json     @default("[]")
  addresses    Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}
