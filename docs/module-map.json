{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "modules": {
    "core": {
      "name": "core",
      "owner": "platform-team",
      "scope": "Cross-cutting identity services: numbering engine, audit logging, system notifications, settings",
      "schemaPrefix": "cor",
      "tables": [
        "audit_logs",
        "system_settings",
        "document_sequences"
      ],
      "mayImport": [],
      "events": {
        "publishes": [
          "SystemNotificationEmitted"
        ],
        "consumes": []
      }
    },
    "identity": {
      "name": "identity",
      "owner": "security-team",
      "scope": "User authentication, profile management, RBAC authorization, and tenant isolation",
      "schemaPrefix": "idn",
      "tables": [
        "user",
        "session",
        "account",
        "verification",
        "tenants",
        "plants",
        "roles",
        "user_profiles",
        "plant_user",
        "user_preferences"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [
          "UserCreated",
          "UserRoleChanged",
          "SessionTerminated"
        ],
        "consumes": []
      }
    },
    "masterdata": {
      "name": "masterdata",
      "owner": "engineering-team",
      "scope": "Item Master catalog, mold/tooling directory, warehouse/bin master, and catalog governance",
      "schemaPrefix": "mdm",
      "tables": [
        "items",
        "mold_tools",
        "warehouses",
        "plants"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [
          "ItemCreated",
          "ItemUpdated",
          "ItemStatusChanged"
        ],
        "consumes": []
      }
    },
    "engineering": {
      "name": "engineering",
      "owner": "engineering-team",
      "scope": "Multi-level Bill of Materials (BOM), recipe scaling, ECO/ECR orders, and routing operations",
      "schemaPrefix": "eng",
      "tables": [
        "bill_of_materials",
        "bom_items",
        "engineering_change_requests",
        "engineering_change_orders",
        "process_routings"
      ],
      "mayImport": [
        "core",
        "masterdata"
      ],
      "events": {
        "publishes": [
          "BomVersionApproved",
          "EcoCompleted"
        ],
        "consumes": [
          "ItemUpdated"
        ]
      }
    },
    "procurement": {
      "name": "procurement",
      "owner": "procurement-team",
      "scope": "Suppliers, Purchase Requisitions, POs, Vendor Pricing, 3-Way Match, and Goods Receipt (GRN)",
      "schemaPrefix": "prc",
      "tables": [
        "suppliers",
        "purchase_orders",
        "purchase_requisitions",
        "goods_receipt_notes",
        "rfqs"
      ],
      "mayImport": [
        "core",
        "masterdata",
        "warehouse"
      ],
      "events": {
        "publishes": [
          "GrnPosted",
          "PoApproved",
          "PoClosed"
        ],
        "consumes": [
          "StockShortageDetected"
        ]
      }
    },
    "warehouse": {
      "name": "warehouse",
      "owner": "supply-chain-team",
      "scope": "Inventory stock ledger, 2D bin maps, putaway, pick/pack fulfillment, stock transfers, and batch tracking",
      "schemaPrefix": "whs",
      "tables": [
        "stock_ledger",
        "stock_transfers",
        "bin_locations",
        "inventory_batches",
        "cycle_counts"
      ],
      "mayImport": [
        "core",
        "masterdata"
      ],
      "events": {
        "publishes": [
          "StockTransferred",
          "LotHeld",
          "LotReleased",
          "StockShortageDetected"
        ],
        "consumes": [
          "GrnPosted",
          "ProductionCompleted",
          "DispatchPosted"
        ]
      }
    },
    "sales": {
      "name": "sales",
      "owner": "sales-team",
      "scope": "Customer directory, Sales Orders, Quotations, Delivery Challans, and E-Way Bill transit",
      "schemaPrefix": "sal",
      "tables": [
        "customers",
        "sales_orders",
        "quotations",
        "delivery_challans",
        "e_invoices",
        "e_way_bills"
      ],
      "mayImport": [
        "core",
        "masterdata",
        "warehouse",
        "integrations"
      ],
      "events": {
        "publishes": [
          "SalesOrderConfirmed",
          "DispatchPosted",
          "InvoiceIssued"
        ],
        "consumes": [
          "ProductionCompleted"
        ]
      }
    },
    "manufacturing": {
      "name": "manufacturing",
      "owner": "production-team",
      "scope": "Work orders, planning board, daily production log, shopfloor kiosk, regrind recycling, machine status",
      "schemaPrefix": "mfg",
      "tables": [
        "work_orders",
        "daily_production_entries",
        "machines",
        "regrind_entries",
        "scrap_records"
      ],
      "mayImport": [
        "core",
        "engineering",
        "warehouse",
        "hr"
      ],
      "events": {
        "publishes": [
          "ProductionCompleted",
          "ScrapReported",
          "MachineDowntimeLogged"
        ],
        "consumes": [
          "BomVersionApproved"
        ]
      }
    },
    "quality": {
      "name": "quality",
      "owner": "quality-team",
      "scope": "QC inspections, NCR non-conformance, CAPA 8D resolution, COA certificates, and SPC telemetry",
      "schemaPrefix": "qua",
      "tables": [
        "inspection_lots",
        "ncrs",
        "capas",
        "coas",
        "spc_subgroups"
      ],
      "mayImport": [
        "core",
        "warehouse"
      ],
      "events": {
        "publishes": [
          "LotReleased",
          "LotRejected",
          "NcrRaised",
          "CapaClosed"
        ],
        "consumes": [
          "GrnPosted",
          "ProductionCompleted"
        ]
      }
    },
    "planning": {
      "name": "planning",
      "owner": "planning-team",
      "scope": "MRP requirements planning, JIT production scheduling, capacity load calculations",
      "schemaPrefix": "scm",
      "tables": [
        "mrp_runs",
        "planned_orders",
        "jit_schedules",
        "capacity_plans"
      ],
      "mayImport": [
        "core",
        "engineering",
        "sales",
        "procurement",
        "warehouse",
        "manufacturing"
      ],
      "events": {
        "publishes": [
          "MrpPlannedOrdersGenerated",
          "JitSchedulePublished"
        ],
        "consumes": [
          "SalesOrderConfirmed",
          "ItemCreated"
        ]
      }
    },
    "finance": {
      "name": "finance",
      "owner": "finance-team",
      "scope": "Chart of accounts, general ledger vouchers, AR/AP aging, GST tax workbench, product costing",
      "schemaPrefix": "fin",
      "tables": [
        "accounts",
        "journal_entries",
        "ar_invoices",
        "ap_vouchers",
        "tax_records",
        "costing_sheets"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [
          "JournalEntryPosted",
          "PeriodClosed"
        ],
        "consumes": [
          "GrnPosted",
          "InvoiceIssued",
          "DispatchPosted",
          "ProductionCompleted"
        ]
      }
    },
    "maintenance": {
      "name": "maintenance",
      "owner": "engineering-team",
      "scope": "Machine health telemetry, mold tooling preventive maintenance, utility MEP work orders",
      "schemaPrefix": "mep",
      "tables": [
        "maintenance_work_orders",
        "equipment_assets",
        "meter_readings",
        "spare_inventory"
      ],
      "mayImport": [
        "core",
        "manufacturing",
        "warehouse"
      ],
      "events": {
        "publishes": [
          "MachineMaintenanceScheduled",
          "BreakdownResolved"
        ],
        "consumes": [
          "MachineDowntimeLogged"
        ]
      }
    },
    "hr": {
      "name": "hr",
      "owner": "hr-team",
      "scope": "Employee directory, shift rosters, skill matrices, attendance, and payroll slips",
      "schemaPrefix": "hrm",
      "tables": [
        "employees",
        "shift_rosters",
        "skill_certifications",
        "payroll_runs",
        "attendance_records"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [
          "OperatorShiftAssigned",
          "PayrollProcessed"
        ],
        "consumes": []
      }
    },
    "crm": {
      "name": "crm",
      "owner": "sales-team",
      "scope": "Customer leads, pricing inquiries, opportunity pipeline, and quotation costing models",
      "schemaPrefix": "crm",
      "tables": [
        "crm_leads",
        "crm_inquiries",
        "opportunity_pipeline",
        "customer_feedback"
      ],
      "mayImport": [
        "core",
        "sales",
        "manufacturing"
      ],
      "events": {
        "publishes": [
          "InquiryCosted",
          "OpportunityWon"
        ],
        "consumes": []
      }
    },
    "analytics": {
      "name": "analytics",
      "owner": "analytics-team",
      "scope": "Executive KPI dashboards, plant OEE gauges, query assistant telemetry, and report builders",
      "schemaPrefix": "int",
      "tables": [
        "analytics_dashboards",
        "saved_reports",
        "query_logs"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [],
        "consumes": []
      }
    },
    "integrations": {
      "name": "integrations",
      "owner": "platform-team",
      "scope": "Government NIC e-way bill & e-invoice gateway, WhatsApp/email alerts, webhook dispatchers",
      "schemaPrefix": "int",
      "tables": [
        "integration_logs",
        "webhook_endpoints",
        "api_tokens"
      ],
      "mayImport": [
        "core"
      ],
      "events": {
        "publishes": [
          "EwbDispatched",
          "WebhookDelivered"
        ],
        "consumes": [
          "InvoiceIssued",
          "DispatchPosted"
        ]
      }
    },
    "workspace": {
      "name": "workspace",
      "owner": "platform-team",
      "scope": "Workspace home, universal task aggregator, approvals hub, notifications drawer, saved views",
      "schemaPrefix": "wsh",
      "tables": [
        "user_tasks",
        "approvals_queue",
        "user_notifications",
        "saved_presets"
      ],
      "mayImport": [
        "core",
        "identity",
        "masterdata",
        "engineering",
        "procurement",
        "warehouse",
        "sales",
        "manufacturing",
        "quality",
        "planning",
        "finance",
        "maintenance",
        "hr",
        "crm",
        "analytics",
        "integrations"
      ],
      "events": {
        "publishes": [
          "ApprovalDecided",
          "TaskCompleted"
        ],
        "consumes": [
          "PoApproved",
          "BomVersionApproved",
          "NcrRaised"
        ]
      }
    }
  }
}
