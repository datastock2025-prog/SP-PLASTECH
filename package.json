{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "middleware",
    "frontend/apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:middleware": "npm --prefix middleware run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "preview:cloudflare": "npm --prefix frontend run build && npm --prefix middleware run preview:cloudflare",
    "seed:supabase": "node scripts/seedSupabaseLive.cjs",
    "clean": "rm -rf dist server.js frontend/dist",
    "lint": "npm --prefix frontend run lint",
    "dev:podman": "podman compose up --build",
    "test:unit": "npm --prefix frontend run test:unit",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:circular": "node ./node_modules/madge/bin/cli.js --circular --extensions ts,tsx src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "gen:module": "plop module",
    "gen:resource": "plop resource",
    "check:licenses": "license-checker-rseidelsohn --production --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;Python-2.0;CC0-1.0;Unlicense;OFL-1.1;CC-BY-4.0;MPL-2.0\" --excludePrivatePackages",
    "check:licenses:dev": "license-checker-rseidelsohn --development --onlyAllow \"MIT;ISC;BSD-2-Clause;BSD-3-Clause;Apache-2.0;0BSD;BlueOak-1.0.0;Python-2.0;CC0-1.0;Unlicense;MPL-2.0;CC-BY-3.0;Zlib\" --excludePrivatePackages"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "radix-ui": "^1.7.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-app": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "dbmate": "^2.36.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.12.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "msw": "^3.0.3",
    "pg": "^8.23.1",
    "plop": "^4.0.5",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.1.14",
    "testcontainers": "^12.2.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.4"
  }
}
