# ==============================================================================
# SP-PLASTECH ERP — ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env for local development. Never commit real secrets.
# ==============================================================================

# Database Configuration (Local Podman PostgreSQL 16)
DEV_DB_PASSWORD=erp_local_only
DATABASE_URL=postgres://erp:erp_local_only@localhost:5432/erp
AUTH_DATABASE_URL=postgres://erp:erp_local_only@localhost:5432/erp

# Authentication Service (Hono + Better-Auth on Port 4000)
BETTER_AUTH_SECRET=replace_with_64_character_random_hex_secret_in_production
BETTER_AUTH_URL=http://localhost:4000
AUTH_PORT=4000
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TENANT_CODE=SP-PLASTECH
TENANT_NAME=SP-PLASTECH Polymer Solutions

# Initial Bootstrap Super Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@spplastech.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_bootstrap_password_on_first_login
BOOTSTRAP_ADMIN_NAME=System Administrator

# Frontend & Vite Proxy Configuration
VITE_API_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
PORT=3000

# Optional Cloud Services (Leave blank for local offline mode)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
GEMINI_API_KEY=
