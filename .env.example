# ==============================================================================
# SP-PLASTECH ERP — UNIFIED MONOREPO CONFIGURATION (.env.example)
#
# SINGLE SOURCE OF TRUTH (SSOT): This single root .env is read by:
#  - Frontend (Vite reads from workspace root via envDir: '..')
#  - Backend (Node / Hono / Better-Auth in middleware/ reads root .env)
#
# COPY THIS FILE TO .env IN WORKSPACE ROOT FOR LOCAL DEVELOPMENT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CLIENT (PORT 3000)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_API_URL=http://localhost:3000
VITE_APP_NAME="SP-PLASTECH ERP"
VITE_APP_VERSION="1.0.0"
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. BACKEND API GATEWAY & BETTER-AUTH SERVICE (PORT 4000)
# ------------------------------------------------------------------------------
PORT=4000
AUTH_PORT=4000
BACKEND_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=sp_plastech_dev_secret_key_reboot_2026_safe_local
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE (Podman / Local / Cloud)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://erp:erp_local_only@172.18.214.127:5432/erp
AUTH_DATABASE_URL=postgres://erp:erp_local_only@172.18.214.127:5432/erp

# ------------------------------------------------------------------------------
# 4. MULTI-TENANT BOOTSTRAP CONTEXT
# ------------------------------------------------------------------------------
TENANT_CODE=SP-PLASTECH
TENANT_NAME=SP-PLASTECH Polymer Solutions
BOOTSTRAP_ADMIN_EMAIL=admin@spplastech.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Plas!Tech#Boot91
BOOTSTRAP_ADMIN_NAME=System Administrator

# ------------------------------------------------------------------------------
# 5. BACKGROUND JOBS & QUEUES (PG-BOSS)
# ------------------------------------------------------------------------------
PG_BOSS_ENABLED=true
PG_BOSS_SCHEMA=pgboss

# ------------------------------------------------------------------------------
# 6. OPTIONAL THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
