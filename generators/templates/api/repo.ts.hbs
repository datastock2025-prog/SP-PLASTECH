import type { PoolClient } from 'pg';

export async function find{{pascalCase name}}ById(c: PoolClient, tenantId: string, id: string) {
  const { rows } = await c.query(
    `SELECT * FROM {{snakeCase name}} WHERE id = $1 AND tenant_id = $2 AND deleted_at IS NULL`,
    [id, tenantId]
  );
  return rows[0] || null;
}
